          "objectCode": {
            "type": "string",
            "description": "Optional object code for access checks."
          }
        },
        "required": ["commentID", "type"],
        "additionalProperties": false
      },
      "ReactionRecord": {
        "type": "object",
        "description": "Reaction added to a comment.",
        "properties": {
          "commentID": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "userID": {
            "type": "string",
            "description": "User who added the reaction."
          }
        },
        "required": ["commentID", "type", "userID"],
        "additionalProperties": true
      },
      "ReactionDeleteAck": {
        "type": "object",
        "description": "Acknowledgement of reaction removal.",
        "properties": {
