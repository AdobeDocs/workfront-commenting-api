            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "Pass as the `cursor` query parameter on the next request."
          }
        },
        "required": ["hasNextPage"],
        "additionalProperties": false
      },
      "CommentList": {
        "type": "object",
        "description": "Paginated list of comments for an object.",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Comment" }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": ["data", "pageInfo"],
        "additionalProperties": false
      },
      "Comment": {
        "type": "object",
        "description": "Comment resource. Exact fields returned depend on `objectCode`, feature flags, and projection logic. Clients should tolerate unknown fields.",
        "additionalProperties": true,
        "properties": {
          "_id": {
            "type": "string",
            "description": "Comment identifier (24-character hex ObjectId)."
          },
          "documentID": {
            "type": "string",
            "description": "Stable document key for threading and position."
          },
          "objectID": {
            "type": "string",
            "description": "Associated object ID."
          },
          "objectCode": {
            "type": "string",
            "description": "Associated object type code."
          },
          "parentID": {
            "type": "string",
            "nullable": true,
            "description": "Parent comment ID for replies."
          },
          "parentCommentID": {
            "type": "string",
            "nullable": true,
            "description": "Resolved parent comment reference."
          },
          "type": {
            "type": "string",
            "description": "Comment type discriminator."
          },
          "content": {
            "type": "string",
            "description": "Plain-text content."
          },
          "contentHTML": {
            "type": "string",
            "nullable": true,
            "description": "HTML content."
          },
          "isPrivate": {
            "type": "boolean",
            "description": "Company-scoped visibility flag."
          },
          "authorID": {
            "type": "string",
            "description": "Author user ID."
          },
          "authorName": {
            "type": "string",
            "description": "Author display name when available."
          },
          "customerId": {
            "type": "string",
            "description": "Customer (tenant) identifier."
          },
          "companyID": {
            "type": "string",
            "description": "Company identifier when applicable."
          },
          "externalRefID": {
            "type": "string",
            "nullable": true,
            "description": "External correlation ID."
          },
          "createdAt": {
            "type": "number",
            "description": "Creation timestamp (Unix milliseconds)."
          },
          "lastModifiedAt": {
            "type": "number",
            "description": "Last modification timestamp (Unix milliseconds)."
          },
          "modifiedBy": {
            "type": "string",
            "description": "User ID of the last modifier."
          },
          "modified": {
            "type": "boolean",
            "description": "Whether the comment was edited after creation."
          },
          "edited": {
            "type": "boolean",
            "description": "Whether the comment content was edited."
          },
          "deleted": {
            "type": "boolean",
            "description": "Soft-delete flag."
          },
          "deletedBy": {
            "type": "string",
            "description": "User ID that deleted the comment."
          },
          "deletedDate": {
            "type": "number",
            "description": "Deletion timestamp (Unix milliseconds)."
          },
          "resolved": {
            "type": "boolean",
            "description": "Whether the comment thread is resolved."
          },
          "resolvedBy": {
            "type": "string",
            "description": "User ID that resolved the comment."
          },
          "tags": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Tag" }
          },
          "attachments": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Attachment" }
          },
          "metadata": {
            "$ref": "#/components/schemas/CommentMetadata"
          },
          "reactions": {
            "type": "array",
            "description": "Embedded reaction summaries when present.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "replies": {
            "type": "array",
            "description": "Nested replies when included in the projection.",
            "items": { "$ref": "#/components/schemas/Comment" }
          }
        }
      }
    }
  }
}
